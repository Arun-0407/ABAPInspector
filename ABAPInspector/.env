# ─────────────────────────────────────────────────────
# ABAP Inspector — Local Development Environment Config
# ─────────────────────────────────────────────────────

# Anthropic API Key (for AI analysis)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── S/4HANA SSL Fix (for self-signed certificates only) ──
# If your S/4HANA system uses a self-signed SSL certificate,
# uncomment the line below to bypass SSL verification.
# ⚠️ WARNING: Only use this for local development/testing — NEVER in production!
# NODE_TLS_REJECT_UNAUTHORIZED=0
